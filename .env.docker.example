APP_NAME="API Tamjid"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tamjid.or.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration (Internal Docker MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pesantren
DB_USERNAME=root
DB_PASSWORD=your_production_mysql_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis Configuration (Internal Docker Redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tamjid.or.id"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Authentication (Tymon JWT)
JWT_SECRET=generate_with_php_artisan_jwt_secret
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Inter-Service Integration
BANK_SANTRI_URL=http://bms-app
BANK_SANTRI_INTERNAL_KEY=smpt-banksantri-internal-secret-2026
TARBIYAH_URL=http://tarbiyah-app
TARBIYAH_INTERNAL_KEY=smpt-tarbiyah-internal-secret-2026
